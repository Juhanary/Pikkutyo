# Kopioi tiedostoksi .env (ei mene gittiin). Älä koskaan laita SECRET-avainta
# NEXT_PUBLIC_-alkuiseen muuttujaan: ne päätyvät selaimeen.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://dsffplcopxwhuksryoxo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://dsffplcopxwhuksryoxo.supabase.co/auth/v1/.well-known/jwks.json

# Testit (npm run db:test): Supabase → Connect → Session pooler (IPv4). Korvaa [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.dsffplcopxwhuksryoxo:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Valinnainen: Supabasen CA-varmenne (Project Settings → Database → SSL Configuration)
# SUPABASE_DB_CA_FILE=./prod-ca-2021.crt

# Sivusto (apps/web)
SITE_URL=http://localhost:3000
APP_URL=http://localhost:8080
# /api/revalidate-kutsujen salaisuus (pitkä satunnainen merkkijono)
REVALIDATE_SECRET=
# Tuotannossa indeksointi sallitaan Vercelissä automaattisesti; paikallisesti voi testata:
# ALLOW_INDEXING=true
# Tarjoajahakemuksen testikytkimet (tunnistus ja kurssi ilman oikeaa palvelua).
# Ei koskaan tuotannossa (Vercelin tuotannossa ne ovat pois päältä aina).
# ALLOW_TEST_SHORTCUTS=true

# Maksut (Edge Functions: supabase secrets set ...). Oletus on testimaksut: raha ei liiku.
# PAYMENT_GATEWAY=fake            # fake | stripe
# FAKE_AUTHORIZE_RESULT=authorized  # authorized | requires_action | failed (testaukseen)
# STRIPE_SECRET_KEY=sk_test_...   # vain kun PAYMENT_GATEWAY=stripe
# STRIPE_WEBHOOK_SECRET=whsec_...
# ALLOW_LIVE_PAYMENTS=true        # vaaditaan, jos avain on sk_live_
